{
  "name": "compelem-i18n",
  "version": "0.3.0-beta.2",
  "description": "An i18n plugin for CompElem",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "llms.txt",
    "README.md"
  ],
  "keywords": [
    "compelem",
    "i18n",
    "internationalization",
    "localization",
    "webcomponent",
    "locale"
  ],
  "author": "holyhigh2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holyhigh2/compelem-i18n.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@compelem/compiler": "^0.30.0-beta.3",
    "@types/node": "^26.4.1",
    "compelem": "^0.30.0-beta.3",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.0",
    "myfx": "^2.0.0-beta.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.11"
  }
}